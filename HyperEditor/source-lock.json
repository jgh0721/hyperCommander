  "policy": "MainWindow, application settings, direct writes and shadow backup are replaced by HC services; original vendor naming retained inside this isolated port.",
  "features": [
    {
      "id": "P2-T01",
      "status": "ported",
      "implementation": "Scintilla/Lexilla source targets and QTextView buffer adapter"
    },
    {
      "id": "P2-T02",
      "status": "ported",
      "implementation": "encoding/BOM/EOL, search/regex/ranges/exclusions, undo, folds/ruler/history and workspace recovery; bounded cancellation"
    },
    {
      "id": "P2-P01",
      "status": "ported",
      "implementation": "pinned PDFium, bounded input, owner-thread coalesced render queue, byte-cost page cache"
    },
    {
      "id": "P2-P02",
      "status": "ported",
      "implementation": "search/selection/printing, six annotation types, Unicode vector appearances, per-page rotations and transactional persistence"
    },
    {
      "id": "P2-I01",
      "status": "ported",
      "implementation": "bounded image decoding, metadata, local directory traversal and slideshow; provider copies do not traverse siblings"
    },
    {
      "id": "P2-I02",
      "status": "ported",
      "implementation": "pixel edit history, crop/draw/text/composition and quality/format exports"
    },
    {
      "id": "P2-I03",
      "status": "ported",
      "implementation": "kernel registry, bilinear/Catmull-Rom/Mitchell/Lanczos3"
    },
    {
      "id": "P2-I04",
      "status": "ported",
      "implementation": "Jacobian EWA Robidoux, widened shrink support, global-coordinate tile halo, linear premultiplied alpha, revision/transform/DPR/profile/tile cache keys and cancellation"
    },
    {
      "id": "P2-U01",
      "status": "ported",
      "implementation": "per-pane toolbars, print/ranges/preview, screen capture and shared waterColor chrome"
    },
    {
      "id": "pdf.forms",
      "status": "unfinished-in-origin",
      "implementation": "form handles deliberately unavailable; no claim of interactive form editing"
    },
    {
      "id": "markdown.webPreview",
      "status": "not-selected-optional",
      "implementation": "Markdown source uses text view; no new WebEngine runtime"
    }
  ],
