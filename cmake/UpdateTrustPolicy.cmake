function(hc_generate_update_trust_policy Output)
    set(POLICY_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/update/signing-policy.json")
    file(READ "${POLICY_PATH}" POLICY_JSON)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${POLICY_PATH}")
    foreach(KIND IN ITEMS PRODUCT VENDOR)
        if(KIND STREQUAL "PRODUCT")
            set(KEY productCertificateSha256)
        else()
            set(KEY vendorCertificates "Everything64.dll")
        endif()
        string(JSON COUNT LENGTH "${POLICY_JSON}" ${KEY})
        if(COUNT LESS 1 OR COUNT GREATER 8)
            message(FATAL_ERROR "Invalid update signer pin count")
        endif()
        math(EXPR LAST "${COUNT}-1")
        set(HC_${KIND}_PINS_CPP "")
        foreach(INDEX RANGE ${LAST})
            string(JSON PIN GET "${POLICY_JSON}" ${KEY} ${INDEX})
            string(LENGTH "${PIN}" LENGTH)
            if(NOT LENGTH EQUAL 64 OR NOT PIN MATCHES "^[0-9a-f]+$")
                message(FATAL_ERROR "Invalid update signer SHA256 certificate pin")
            endif()
            string(APPEND HC_${KIND}_PINS_CPP "\"${PIN}\",")
        endforeach()
    endforeach()
    # The UTF-8 template already carries the required BOM.
    set(HC_HEADER_BOM "")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../HyperCommanderUpdater/updateSigningPolicy.hpp.in"
        "${Output}" @ONLY NEWLINE_STYLE CRLF)
endfunction()
