set(SOURCE "@CMAKE_BINARY_DIR@/${CMAKE_INSTALL_CONFIG_NAME}")
file(READ "${SOURCE}/product-inventory.json" INVENTORY)
string(JSON SCHEMA GET "${INVENTORY}" schemaVersion)
string(JSON CONFIG GET "${INVENTORY}" configuration)
if(NOT SCHEMA EQUAL 1 OR NOT CONFIG STREQUAL CMAKE_INSTALL_CONFIG_NAME)
    message(FATAL_ERROR "Product inventory configuration mismatch; build the requested configuration first")
endif()
if(CONFIG STREQUAL "Release")
    execute_process(COMMAND powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "@PROJECT_SOURCE_DIR@/tools/update/Test-ProductSignatures.ps1" -Root "${SOURCE}"
        INPUT_FILE NUL RESULT_VARIABLE SIGNATURE_RESULT)
    if(NOT SIGNATURE_RESULT EQUAL 0)
        message(FATAL_ERROR "Release installation requires verified product code signatures")
    endif()
endif()
string(JSON COUNT LENGTH "${INVENTORY}" files)
math(EXPR LAST "${COUNT}-1")
set(FILES)
set(HASHES)
foreach(INDEX RANGE ${LAST})
    string(JSON NAME GET "${INVENTORY}" files ${INDEX} path)
    string(JSON EXPECTED GET "${INVENTORY}" files ${INDEX} sha256)
    if(NAME MATCHES "(^/|/$|//|^[A-Za-z]:|(^|/)\\.\\.?(/|$))" OR NAME MATCHES "[\\\\:;]")
        message(FATAL_ERROR "Invalid inventory path")
    endif()
    string(REPLACE "/" ";" PARTS "${NAME}")
    foreach(PART IN LISTS PARTS)
        if(PART MATCHES "[. ]$")
            message(FATAL_ERROR "Invalid Win32 inventory alias")
        endif()
    endforeach()
    file(SHA256 "${SOURCE}/${NAME}" ACTUAL)
    if(NOT ACTUAL STREQUAL EXPECTED)
        message(FATAL_ERROR "Product input hash mismatch: ${NAME}")
    endif()
    list(APPEND FILES "${NAME}")
    list(APPEND HASHES "${EXPECTED}")
endforeach()
string(JSON RHWP_PIN ERROR_VARIABLE RHWP_ABSENT GET "${INVENTORY}" rhwpInventorySha256)
set(RHWP_FILES)
if(NOT RHWP_ABSENT)
    execute_process(COMMAND powershell -NoProfile -ExecutionPolicy Bypass
        -File "@PROJECT_SOURCE_DIR@/tools/rhwp/Test-ProductRuntime.ps1"
        -RuntimeRoot "${SOURCE}" -SharedRoot -ExpectedSha256 "${RHWP_PIN}"
        -DestinationRoot "${CMAKE_INSTALL_PREFIX}" -AsJson
        RESULT_VARIABLE RHWP_RESULT OUTPUT_VARIABLE RHWP_VALIDATED ERROR_VARIABLE RHWP_ERROR)
    if(NOT RHWP_RESULT EQUAL 0)
        message(FATAL_ERROR "RHWP installation rejected: ${RHWP_ERROR}")
    endif()
    string(JSON RHWP_COUNT LENGTH "${RHWP_VALIDATED}" files)
    math(EXPR RHWP_LAST "${RHWP_COUNT}-1")
    foreach(RHWP_INDEX RANGE ${RHWP_LAST})
        string(JSON RHWP_NAME GET "${RHWP_VALIDATED}" files ${RHWP_INDEX} path)
        list(APPEND RHWP_FILES "${RHWP_NAME}")
        if(NOT "${RHWP_NAME}" IN_LIST FILES)
            message(FATAL_ERROR "RHWP product input missing: ${RHWP_NAME}")
        endif()
    endforeach()
endif()
# Files only the runtime owns must all be approved by the pinned runtime inventory.
foreach(NAME IN LISTS FILES)
    string(TOLOWER "${NAME}" LOWER_NAME)
    if(LOWER_NAME MATCHES "^(hypereditorweb[.]exe|qtwebengineprocess[.]exe|runtime-inventory[.]json|libs/(resources|bundle|translations/qtwebengine_locales)/)"
        AND NOT NAME IN_LIST RHWP_FILES)
        message(FATAL_ERROR "Unapproved RHWP product input: ${NAME}")
    endif()
endforeach()
# Verify the complete source before writing; install only the recorded products.
foreach(INDEX RANGE ${LAST})
    list(GET FILES ${INDEX} NAME)
    list(GET HASHES ${INDEX} EXPECTED)
    file(SHA256 "${SOURCE}/${NAME}" ACTUAL)
    if(NOT ACTUAL STREQUAL EXPECTED)
        message(FATAL_ERROR "Product input changed during installation: ${NAME}")
    endif()
    get_filename_component(FOLDER "${NAME}" DIRECTORY)
    file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/${FOLDER}" TYPE FILE FILES "${SOURCE}/${NAME}")
    file(SHA256 "${CMAKE_INSTALL_PREFIX}/${NAME}" ACTUAL)
    if(NOT ACTUAL STREQUAL EXPECTED)
        message(FATAL_ERROR "Installed product hash mismatch: ${NAME}")
    endif()
endforeach()
file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}" TYPE FILE FILES "${SOURCE}/product-inventory.json")
