# Reads the path ownership of tools/update/update-contract.json. Sets in the
# caller: HC_OWNED_rootFiles, HC_OWNED_rootDllPrefixes, HC_OWNED_directories,
# HC_UPDATER_FLOOR, HC_ROOT_CARRIER ("Libs/RootFiles/") and HC_CARRIED_ROOT_FILES.
# Also used by script-mode callers such as GenerateProductInventory.cmake.
function(hc_read_update_ownership)
    set(CONTRACT_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/update/update-contract.json")
    file(READ "${CONTRACT_PATH}" CONTRACT_JSON)
    string(JSON ENTRY_COUNT LENGTH "${CONTRACT_JSON}" ownership)
    if(ENTRY_COUNT LESS 1)
        message(FATAL_ERROR "The update contract has no path ownership entries")
    endif()
    # Entries add paths for clients from their version on. The updater accepts
    # their union; packages use the same entries to find their oldest client.
    set(PATTERN_rootFiles "^[A-Za-z0-9_.+-]+$")
    set(PATTERN_rootDllPrefixes "^[A-Za-z0-9_.+-]+$")
    set(PATTERN_directories "^([A-Za-z0-9_.+-]+/)+$")
    # The oldest released updater must accept every package. Root files it does
    # not own ship under rootCarrier, a folder it owns, and newer code copies
    # them to ROOT. Only plain root files can travel that way.
    string(JSON FLOOR GET "${CONTRACT_JSON}" updaterFloor version)
    string(JSON CARRIER GET "${CONTRACT_JSON}" rootCarrier)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ProductLayout.cmake")
    if(NOT FLOOR MATCHES "^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$" OR NOT CARRIER STREQUAL "${HC_LAYOUT_RootCarrier}/")
        message(FATAL_ERROR "The update contract needs an updaterFloor version and rootCarrier \"${HC_LAYOUT_RootCarrier}/\"")
    endif()
    set(CARRIER_OWNED FALSE)
    set(CARRIED "")
    set(PREVIOUS "")
    math(EXPR LAST "${ENTRY_COUNT}-1")
    foreach(INDEX RANGE ${LAST})
        string(JSON SINCE GET "${CONTRACT_JSON}" ownership ${INDEX} since)
        if(NOT SINCE MATCHES "^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$" OR (PREVIOUS AND NOT SINCE VERSION_GREATER PREVIOUS))
            message(FATAL_ERROR "Update ownership entries need increasing four-part versions: ${SINCE}")
        endif()
        if(INDEX EQUAL 0 AND SINCE VERSION_GREATER FLOOR)
            message(FATAL_ERROR "The updater floor ${FLOOR} predates the first ownership entry")
        endif()
        set(PREVIOUS "${SINCE}")
        foreach(KEY IN ITEMS rootFiles rootDllPrefixes directories)
            string(JSON COUNT ERROR_VARIABLE MISSING LENGTH "${CONTRACT_JSON}" ownership ${INDEX} ${KEY})
            if(MISSING OR COUNT LESS 1)
                continue()
            endif()
            if(SINCE VERSION_GREATER FLOOR AND NOT KEY STREQUAL "rootFiles")
                message(FATAL_ERROR "Ownership ${SINCE} adds ${KEY} after the updater floor ${FLOOR}; ship them under a folder the floor owns")
            endif()
            math(EXPR LAST_VALUE "${COUNT}-1")
            foreach(VALUE_INDEX RANGE ${LAST_VALUE})
                string(JSON VALUE GET "${CONTRACT_JSON}" ownership ${INDEX} ${KEY} ${VALUE_INDEX})
                if(NOT VALUE MATCHES "${PATTERN_${KEY}}" OR VALUE IN_LIST OWNED_${KEY})
                    message(FATAL_ERROR "Invalid or repeated update ownership ${KEY} value: ${VALUE}")
                endif()
                list(APPEND OWNED_${KEY} "${VALUE}")
                if(SINCE VERSION_GREATER FLOOR)
                    list(APPEND CARRIED "${VALUE}")
                elseif(KEY STREQUAL "directories")
                    string(FIND "${CARRIER}" "${VALUE}" CARRIER_PREFIX)
                    if(CARRIER_PREFIX EQUAL 0)
                        set(CARRIER_OWNED TRUE)
                    endif()
                endif()
            endforeach()
        endforeach()
    endforeach()
    if(NOT CARRIER_OWNED)
        message(FATAL_ERROR "The updater floor ${FLOOR} does not own the root carrier ${CARRIER}")
    endif()
    foreach(KEY IN ITEMS rootFiles rootDllPrefixes directories)
        if(NOT OWNED_${KEY})
            message(FATAL_ERROR "The update contract owns no ${KEY}")
        endif()
        set(HC_OWNED_${KEY} "${OWNED_${KEY}}" PARENT_SCOPE)
    endforeach()
    set(HC_UPDATER_FLOOR "${FLOOR}" PARENT_SCOPE)
    set(HC_ROOT_CARRIER "${CARRIER}" PARENT_SCOPE)
    set(HC_CARRIED_ROOT_FILES "${CARRIED}" PARENT_SCOPE)
endfunction()

function(hc_generate_update_ownership_policy Output)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/update/update-contract.json"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../commonLibs/layout/productLayout.hpp")
    hc_read_update_ownership()
    foreach(KEY IN ITEMS rootFiles rootDllPrefixes directories)
        set(HC_OWNED_${KEY}_CPP "")
        foreach(VALUE IN LISTS HC_OWNED_${KEY})
            string(APPEND HC_OWNED_${KEY}_CPP "\"${VALUE}\", ")
        endforeach()
    endforeach()
    set(HC_CARRIED_ROOT_FILES_CPP "")
    foreach(VALUE IN LISTS HC_CARRIED_ROOT_FILES)
        string(APPEND HC_CARRIED_ROOT_FILES_CPP "\"${VALUE}\", ")
    endforeach()
    list(LENGTH HC_CARRIED_ROOT_FILES HC_CARRIED_ROOT_FILES_COUNT)
    # The UTF-8 template already carries the required BOM.
    set(HC_HEADER_BOM "")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../HyperCommanderUpdater/updateOwnershipPolicy.hpp.in"
        "${Output}" @ONLY NEWLINE_STYLE CRLF)
endfunction()
