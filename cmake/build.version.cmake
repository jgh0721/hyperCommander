include_guard(GLOBAL)

function(hc_split_version VersionText OutMajor OutMinor OutPatch OutTweak)
    if(NOT VersionText MATCHES "^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$")
        message(FATAL_ERROR "HC_PRODUCT_VERSION must have four numeric components: ${VersionText}")
    endif()

    string(REPLACE "." ";" Parts "${VersionText}")
    set(Outputs "${OutMajor}" "${OutMinor}" "${OutPatch}" "${OutTweak}")
    foreach(Index RANGE 0 3)
        list(GET Parts ${Index} Part)
        string(REGEX REPLACE "^0+" "" Value "${Part}")
        if(Value STREQUAL "")
            set(Value 0)
        endif()
        string(LENGTH "${Value}" Length)
        if(Length GREATER 5 OR Value GREATER 65535)
            message(FATAL_ERROR "HC_PRODUCT_VERSION component exceeds the Windows resource limit: ${Part}")
        endif()
        list(GET Outputs ${Index} Output)
        set(${Output} "${Value}" PARENT_SCOPE)
    endforeach()
endfunction()

function(hc_add_version_resource Target Description)
    cmake_parse_arguments(PARSE_ARGV 2 Version "" "ICON" "")
    if(Version_UNPARSED_ARGUMENTS OR Version_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid version resource arguments for ${Target}")
    endif()

    set(RC_VER_MAJOR "${HC_VER_MAJOR}")
    set(RC_VER_MINOR "${HC_VER_MINOR}")
    set(RC_VER_PATCH "${HC_VER_PATCH}")
    set(RC_VER_TWEAK "${HC_VER_TWEAK}")
    set(RC_VERSION_TEXT "${HC_PRODUCT_VERSION}")
    set(RC_COMPANY_NAME "MyHouse.")
    set(RC_PRODUCT_NAME "HyperCommander")
    set(RC_FILE_DESCRIPTION "${Description}")
    set(RC_INTERNAL_NAME "${Target}")
    get_target_property(OutputName ${Target} OUTPUT_NAME)
    if(NOT OutputName)
        set(OutputName "${Target}")
    endif()
    set(RC_ORIGINAL_FILENAME "${OutputName}.exe")
    set(RC_COPYRIGHT "Copyright (C) 2026 MyHouse.")
    if(NOT Version_ICON)
        set(Version_ICON "${PROJECT_SOURCE_DIR}/resources/app-icons/helper.ico")
    endif()
    set(RC_ICON_BLOCK "")
    if(Version_ICON)
        if(NOT EXISTS "${Version_ICON}")
            message(FATAL_ERROR "Version resource icon is missing: ${Version_ICON}")
        endif()
        file(TO_CMAKE_PATH "${Version_ICON}" IconPath)
        set(RC_ICON_BLOCK "IDI_ICON1 ICON \"${IconPath}\"")
    endif()

    set(ResourcePath "${CMAKE_BINARY_DIR}/version/${Target}.rc")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/build.version.rc.in" "${ResourcePath}" @ONLY NEWLINE_STYLE CRLF)
    target_sources(${Target} PRIVATE "${ResourcePath}")
endfunction()
