cmake_minimum_required(VERSION 4.2)
if(NOT IS_DIRECTORY "${SOURCE}" OR NOT CONFIG MATCHES "^(Debug|Release|RelWithDebInfo)$")
    message(FATAL_ERROR "Product runtime directory/configuration is required")
endif()
if(HC_SIGNING_SCRIPT AND CONFIG STREQUAL "Release")
    get_filename_component(HC_SIGNING_TOOLS "${HC_SIGNING_SCRIPT}" DIRECTORY)
    execute_process(COMMAND powershell -NoProfile -ExecutionPolicy Bypass
        -File "${HC_SIGNING_TOOLS}/Sign-ProductTree.ps1" -Root "${SOURCE}" -CacheRoot "${HC_SIGNING_CACHE}"
        RESULT_VARIABLE HC_SIGNING_RESULT)
    if(NOT HC_SIGNING_RESULT EQUAL 0)
        message(FATAL_ERROR "Release product signing failed")
    endif()
    # Runtime deployment can refresh unsigned Qt inputs. Recompute the viewer's
    # dependency hashes only after canonical signatures have been restored.
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DVIEWER=${HC_VIEWER}" "-DRUNTIME=${SOURCE}"
        "-DENGINE_LOCK=${CMAKE_CURRENT_LIST_DIR}/../HyperEditor/source-lock.json"
        "-DPACKAGE=Addons/WLX/HyperViewer" "-DOUTPUT=${SOURCE}/Addons/WLX/HyperViewer"
        "-DCONFIG=${CONFIG}" "-DHC_SIGNING_SCRIPT=${HC_SIGNING_SCRIPT}" "-DHC_SIGNING_CACHE=${HC_SIGNING_CACHE}"
        -P "${CMAKE_CURRENT_LIST_DIR}/../HyperCommanderBuiltInPlugin/HyperViewer/GeneratePackage.cmake"
        RESULT_VARIABLE HC_VIEWER_RESULT)
    if(NOT HC_VIEWER_RESULT EQUAL 0)
        message(FATAL_ERROR "Signed HyperViewer manifest generation failed")
    endif()
endif()
set(FILES HyperCommander.exe HyperCommanderAdmin.exe HyperEditor.exe HyperCompare.exe HyperCompareCli.exe
    hc-plugin-host-x64.exe hc-plugin-inspect.exe hc-search-index.exe Everything64.dll)
if(EXISTS "${SOURCE}/HyperCommanderUpdater.exe")
    list(APPEND FILES HyperCommanderUpdater.exe)
endif()
file(GLOB ROOT_DLLS RELATIVE "${SOURCE}" "${SOURCE}/Qt6*.dll" "${SOURCE}/vcruntime*.dll" "${SOURCE}/msvcp*.dll" "${SOURCE}/concrt*.dll" "${SOURCE}/d3dcompiler_*.dll" "${SOURCE}/opengl32sw.dll" "${SOURCE}/pdfium.dll")
list(FILTER ROOT_DLLS EXCLUDE REGEX "^Qt6Test")
list(APPEND FILES ${ROOT_DLLS})
# Qt plugins and translations are found through the qt.conf embedded in each exe (Plugins=Libs).
foreach(FOLDER IN ITEMS Libs/platforms Libs/imageformats Libs/iconengines Libs/styles Libs/generic Libs/networkinformation
        Libs/tls Libs/sqldrivers Libs/printsupport Libs/translations)
    file(GLOB_RECURSE INPUTS LIST_DIRECTORIES FALSE RELATIVE "${SOURCE}" "${SOURCE}/${FOLDER}/*")
    if(FOLDER STREQUAL "Libs/translations")
        list(FILTER INPUTS INCLUDE REGEX "\\.qm$")
    else()
        list(FILTER INPUTS INCLUDE REGEX "\\.dll$")
    endif()
    list(APPEND FILES ${INPUTS})
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ProductLayout.cmake")
# Every notice and source archive, including the archive plugins', lives under Licenses/<component>.
file(GLOB_RECURSE INPUTS LIST_DIRECTORIES FALSE RELATIVE "${SOURCE}" "${SOURCE}/${HC_LAYOUT_Licenses}/*")
list(APPEND FILES ${INPUTS})
foreach(NAME IN ITEMS hc_isoimage_wcx.wcx64 hc_iso_core.dll isoimage.json source-lock.json)
    list(APPEND FILES "${HC_LAYOUT_IsoImagePackage}/${NAME}")
endforeach()
foreach(NAME IN ITEMS 7z.dll sevenzip.json source-lock.json)
    list(APPEND FILES "${HC_LAYOUT_SevenZipPackage}/${NAME}")
endforeach()
if(EXISTS "${SOURCE}/${HC_LAYOUT_AlzEggPackage}/alzegg.json")
    foreach(NAME IN ITEMS UnEGG64.dll alzegg.json source-lock.json)
        list(APPEND FILES "${HC_LAYOUT_AlzEggPackage}/${NAME}")
    endforeach()
    list(APPEND FILES "${HC_LAYOUT_Licenses}/AlzEgg/UnEGG.txt")
endif()
# The HyperViewer manifest lives in its package folder; its binary and dependencies are ROOT-relative.
set(PACKAGE "${HC_LAYOUT_HyperViewerPackage}")
file(READ "${SOURCE}/${PACKAGE}/hyperviewer.json" MANIFEST)
string(JSON ID GET "${MANIFEST}" id)
string(JSON BINARY GET "${MANIFEST}" binary)
if(NOT ID STREQUAL "builtin.hyperviewer" OR NOT BINARY STREQUAL "${PACKAGE}/HyperViewer.dll")
    message(FATAL_ERROR "Unexpected HyperViewer package identity")
endif()
list(APPEND FILES "${PACKAGE}/hyperviewer.json" "${PACKAGE}/source-lock.json" "${BINARY}")
string(JSON EXPECTED GET "${MANIFEST}" sha256)
file(SHA256 "${SOURCE}/${BINARY}" ACTUAL)
if(NOT EXPECTED STREQUAL ACTUAL)
    message(FATAL_ERROR "HyperViewer binary hash mismatch")
endif()
foreach(GROUP IN ITEMS helpers dependencies)
    string(JSON COUNT ERROR_VARIABLE GROUP_ERROR LENGTH "${MANIFEST}" ${GROUP})
    if(GROUP STREQUAL "helpers" AND GROUP_ERROR)
        continue()
    endif()
    if(GROUP_ERROR OR COUNT LESS 1)
        message(FATAL_ERROR "Empty HyperViewer ${GROUP}")
    endif()
    math(EXPR LAST "${COUNT}-1")
    foreach(INDEX RANGE ${LAST})
        string(JSON NAME MEMBER "${MANIFEST}" ${GROUP} ${INDEX})
        if(NAME MATCHES "(^/|^[A-Za-z]:|(^|/)\.\.(/|$))" OR NAME MATCHES "\\\\")
            message(FATAL_ERROR "Invalid package path: ${NAME}")
        endif()
        string(JSON EXPECTED GET "${MANIFEST}" ${GROUP} "${NAME}")
        file(SHA256 "${SOURCE}/${NAME}" ACTUAL)
        if(NOT EXPECTED STREQUAL ACTUAL)
            message(FATAL_ERROR "HyperViewer input hash mismatch: ${NAME}")
        endif()
        list(APPEND FILES "${NAME}")
    endforeach()
endforeach()
foreach(REQUIRED IN ITEMS pdfium.dll Licenses/Scintilla/License.txt Licenses/Lexilla/License.txt Licenses/PDFium/LICENSE Licenses/waterColorStyle/LICENSE
        Licenses/Lua/ThirdPartyNotices.txt Licenses/IsoImage/COPYING Licenses/SevenZip/License.txt)
    if(NOT REQUIRED IN_LIST FILES)
        message(FATAL_ERROR "Required runtime/license is absent: ${REQUIRED}")
    endif()
endforeach()
if(CONFIG STREQUAL "Debug")
    set(PLATFORM "Libs/platforms/qwindowsd.dll")
else()
    set(PLATFORM "Libs/platforms/qwindows.dll")
endif()
if(NOT PLATFORM IN_LIST FILES)
    message(FATAL_ERROR "Windows platform plugin is missing")
endif()
# An explicit native pin selects the shared runtime; adjacent candidates never opt in.
if(RHWP_SOURCE)
    execute_process(COMMAND powershell -NoProfile -ExecutionPolicy Bypass
        -File "${CMAKE_CURRENT_LIST_DIR}/../tools/rhwp/Test-ProductRuntime.ps1"
        -RuntimeRoot "${RHWP_SOURCE}" -ExpectedSha256 "${RHWP_PIN}"
        -DestinationRoot "${SOURCE}" -AsJson
        RESULT_VARIABLE RHWP_RESULT OUTPUT_VARIABLE RHWP_VALIDATED ERROR_VARIABLE RHWP_ERROR)
    if(NOT RHWP_RESULT EQUAL 0)
        message(FATAL_ERROR "RHWP product runtime rejected: ${RHWP_ERROR}")
    endif()
    string(JSON RHWP_COUNT LENGTH "${RHWP_VALIDATED}" files)
    math(EXPR RHWP_LAST "${RHWP_COUNT}-1")
    # The runtime root is ROOT. Files only the runtime owns may be replaced; shared Qt files must
    # already match, otherwise the product and the pinned runtime come from different Qt builds.
    set(RHWP_OWNED "^(HyperEditorWeb[.]exe|QtWebEngineProcess[.]exe|runtime-inventory[.]json|Libs/(resources|bundle|translations/qtwebengine_locales)/.*)$")
    foreach(RHWP_INDEX RANGE ${RHWP_LAST})
        string(JSON RHWP_NAME GET "${RHWP_VALIDATED}" files ${RHWP_INDEX} path)
        string(JSON RHWP_HASH GET "${RHWP_VALIDATED}" files ${RHWP_INDEX} sha256)
        if(EXISTS "${SOURCE}/${RHWP_NAME}" AND NOT RHWP_NAME MATCHES "${RHWP_OWNED}")
            file(SHA256 "${SOURCE}/${RHWP_NAME}" RHWP_EXISTING)
            if(NOT RHWP_EXISTING STREQUAL RHWP_HASH)
                message(FATAL_ERROR "Shared runtime file differs from the pinned RHWP runtime: ${RHWP_NAME}; rebuild the runtime with tools/rhwp/Build-ProductRuntime.ps1")
            endif()
        endif()
        get_filename_component(RHWP_FOLDER "${RHWP_NAME}" DIRECTORY)
        file(MAKE_DIRECTORY "${SOURCE}/${RHWP_FOLDER}")
        file(COPY_FILE "${RHWP_SOURCE}/${RHWP_NAME}" "${SOURCE}/${RHWP_NAME}" ONLY_IF_DIFFERENT)
        file(SHA256 "${SOURCE}/${RHWP_NAME}" RHWP_ACTUAL)
        if(NOT RHWP_HASH STREQUAL RHWP_ACTUAL)
            message(FATAL_ERROR "RHWP input changed while staging: ${RHWP_NAME}")
        endif()
        list(APPEND FILES "${RHWP_NAME}")
    endforeach()
endif()
if(EPUB_SOURCE)
    execute_process(COMMAND powershell -NoProfile -ExecutionPolicy Bypass
        -File "${CMAKE_CURRENT_LIST_DIR}/../tools/epub/Test-ProductRuntime.ps1"
        -RuntimeRoot "${EPUB_SOURCE}" -ExpectedSha256 "${EPUB_PIN}" -AsJson
        RESULT_VARIABLE EPUB_RESULT OUTPUT_VARIABLE EPUB_VALIDATED ERROR_VARIABLE EPUB_ERROR)
    if(NOT EPUB_RESULT EQUAL 0)
        message(FATAL_ERROR "EPUB runtime rejected: ${EPUB_ERROR}")
    endif()
    execute_process(COMMAND "${EPUB_PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/../tools/epub/deploy_product_runtime.py"
        --runtime "${EPUB_SOURCE}" --manifest-sha256 "${EPUB_PIN}"
        --source "${CMAKE_CURRENT_LIST_DIR}/../tools/epub/web" --application "${SOURCE}"
        RESULT_VARIABLE EPUB_COPY_RESULT)
    if(NOT EPUB_COPY_RESULT EQUAL 0)
        message(FATAL_ERROR "EPUB isolated runtime staging failed")
    endif()
    string(JSON EPUB_COUNT LENGTH "${EPUB_VALIDATED}" files)
    math(EXPR EPUB_LAST "${EPUB_COUNT}-1")
    foreach(EPUB_INDEX RANGE ${EPUB_LAST})
        string(JSON EPUB_NAME GET "${EPUB_VALIDATED}" files ${EPUB_INDEX} path)
        list(APPEND FILES "Libs/Epub/${EPUB_NAME}")
    endforeach()
endif()
list(REMOVE_DUPLICATES FILES)
list(SORT FILES)
set(ENTRIES "[]")
set(INDEX 0)
foreach(NAME IN LISTS FILES)
    if(NOT EXISTS "${SOURCE}/${NAME}" OR IS_DIRECTORY "${SOURCE}/${NAME}")
        message(FATAL_ERROR "Missing product input: ${NAME}")
    endif()
    file(SHA256 "${SOURCE}/${NAME}" HASH)
    set(ENTRY "{}")
    string(JSON ENTRY SET "${ENTRY}" path "\"${NAME}\"")
    string(JSON ENTRY SET "${ENTRY}" sha256 "\"${HASH}\"")
    file(SIZE "${SOURCE}/${NAME}" BYTES)
    string(JSON ENTRY SET "${ENTRY}" size ${BYTES})
    string(JSON ENTRIES SET "${ENTRIES}" ${INDEX} "${ENTRY}")
    math(EXPR INDEX "${INDEX}+1")
endforeach()
set(INVENTORY "{}")
string(JSON INVENTORY SET "${INVENTORY}" schemaVersion 1)
string(JSON INVENTORY SET "${INVENTORY}" configuration "\"${CONFIG}\"")
if(PRODUCT_VERSION)
    string(JSON INVENTORY SET "${INVENTORY}" version "\"${PRODUCT_VERSION}\"")
endif()
string(JSON INVENTORY SET "${INVENTORY}" product "\"HyperCommander\"")
string(JSON INVENTORY SET "${INVENTORY}" layoutVersion 1)
string(JSON INVENTORY SET "${INVENTORY}" updaterProtocol 1)
string(JSON INVENTORY SET "${INVENTORY}" files "${ENTRIES}")
if(RHWP_SOURCE)
    string(JSON INVENTORY SET "${INVENTORY}" rhwpInventorySha256 "\"${RHWP_PIN}\"")
endif()
if(EPUB_SOURCE)
    string(JSON INVENTORY SET "${INVENTORY}" epubInventorySha256 "\"${EPUB_PIN}\"")
endif()
file(CONFIGURE OUTPUT "${SOURCE}/product-inventory.json" CONTENT "${INVENTORY}
" NEWLINE_STYLE CRLF @ONLY)
message(STATUS "Product inventory: ${INDEX} files (${CONFIG})")
if(HC_SIGNING_SCRIPT AND CONFIG STREQUAL "Release")
    execute_process(COMMAND powershell -NoProfile -ExecutionPolicy Bypass
        -File "${HC_SIGNING_TOOLS}/Test-ProductSignatures.ps1" -Root "${SOURCE}"
        RESULT_VARIABLE HC_TRUST_RESULT)
    if(NOT HC_TRUST_RESULT EQUAL 0)
        message(FATAL_ERROR "Release product signature verification failed")
    endif()
endif()
