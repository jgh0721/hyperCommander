# Test selection is intentionally conservative: only audited non-GUI cases run
# concurrently. New/unclassified tests retain desktop serialization until audited.
function(hc_classify_tests Directory)
    get_property(Tests DIRECTORY "${Directory}" PROPERTY TESTS)
    foreach(Test IN LISTS Tests)
        if(Test MATCHES "^(hc\\.(ui_runtime_snapshot|path|commands|columns|workspace|lua_runtime|script_api|wlx_detection|plugin_manifest)|hc\\.epub\\.p0\\.(probe|render.prepare|package.native)|hc\\.epub\\.web\\.[A-Za-z]+|hypercompare.core)$")
            set_property(TEST "${Test}" DIRECTORY "${Directory}" APPEND PROPERTY LABELS fast)
            set_tests_properties("${Test}" DIRECTORY "${Directory}" PROPERTIES RUN_SERIAL FALSE)
        elseif(Test MATCHES "^(hc\\.document\\.p5|hc\\.deployment)$")
            set_property(TEST "${Test}" DIRECTORY "${Directory}" APPEND PROPERTY LABELS release)
            set_tests_properties("${Test}" DIRECTORY "${Directory}" PROPERTIES RESOURCE_LOCK "hc_desktop;hc_product_runtime")
        elseif(Test MATCHES "(archive_stress|archive_nested_smb|paged_storage)")
            set_property(TEST "${Test}" DIRECTORY "${Directory}" APPEND PROPERTY LABELS extended)
        else()
            set_property(TEST "${Test}" DIRECTORY "${Directory}" APPEND PROPERTY LABELS desktop)
            set_tests_properties("${Test}" DIRECTORY "${Directory}" PROPERTIES RESOURCE_LOCK hc_desktop)
        endif()
    endforeach()
    get_property(Children DIRECTORY "${Directory}" PROPERTY SUBDIRECTORIES)
    foreach(Child IN LISTS Children)
        hc_classify_tests("${Child}")
    endforeach()
endfunction()

function(hc_finalize_test_groups)
    hc_classify_tests("${PROJECT_SOURCE_DIR}")
    # A check must never execute a stale binary omitted from a handwritten list.
    hc_collect_executables("${PROJECT_SOURCE_DIR}" Targets)
    foreach(Target IN LISTS Targets)
        get_target_property(Type ${Target} TYPE)
        if(Type STREQUAL "EXECUTABLE")
            add_dependencies(hc_check ${Target})
        endif()
    endforeach()
endfunction()
