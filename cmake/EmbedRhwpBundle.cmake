# Reused by the shared RHWP helper and its resource-path tests.
function(hc_embed_rhwp_bundle TARGET)
    if(NOT HC_RHWP_BUNDLE_DIRECTORY)
        return()
    endif()
    file(REAL_PATH "${HC_RHWP_BUNDLE_DIRECTORY}" BUNDLE_ROOT BASE_DIRECTORY "${PROJECT_SOURCE_DIR}")
    set(MANIFEST "${BUNDLE_ROOT}/asset-manifest.json")
    file(READ "${MANIFEST}" CONTENT)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MANIFEST}")
    string(JSON COUNT LENGTH "${CONTENT}" files)
    if(COUNT LESS 1 OR COUNT GREATER 512)
        message(FATAL_ERROR "Invalid embedded RHWP bundle file count")
    endif()
    set(ASSETS "${MANIFEST}")
    set(SEEN "asset-manifest.json")
    math(EXPR LAST "${COUNT}-1")
    foreach(INDEX RANGE ${LAST})
        string(JSON NAME GET "${CONTENT}" files ${INDEX} path)
        string(JSON PIN GET "${CONTENT}" files ${INDEX} sha256)
        string(TOLOWER "${NAME}" LOWER_NAME)
        if(NOT NAME MATCHES "^[A-Za-z0-9_./-]+$" OR NAME MATCHES "(^/|/$|//|(^|/)\\.\\.?(/|$))" OR LOWER_NAME IN_LIST SEEN)
            message(FATAL_ERROR "Invalid embedded RHWP bundle path: ${NAME}")
        endif()
        file(REAL_PATH "${BUNDLE_ROOT}/${NAME}" REAL_ASSET)
        cmake_path(IS_PREFIX BUNDLE_ROOT "${REAL_ASSET}" NORMALIZE INSIDE)
        if(NOT INSIDE OR IS_DIRECTORY "${REAL_ASSET}")
            message(FATAL_ERROR "Embedded RHWP input escapes bundle: ${NAME}")
        endif()
        file(SHA256 "${REAL_ASSET}" ACTUAL)
        if(NOT PIN STREQUAL ACTUAL)
            message(FATAL_ERROR "Embedded RHWP input hash mismatch: ${NAME}")
        endif()
        list(APPEND SEEN "${LOWER_NAME}")
        list(APPEND ASSETS "${BUNDLE_ROOT}/${NAME}")
    endforeach()
    # Approval remains the separately compiled manifest pin; embedding grants no capability.
    qt_add_resources(${TARGET} "${TARGET}_rhwp_bundle"
        PREFIX "/hc/rhwp/bundle" BASE "${BUNDLE_ROOT}"
        BIG_RESOURCES FILES ${ASSETS})
    target_compile_definitions(${TARGET} PRIVATE HC_RHWP_EMBEDDED_BUNDLE=1)
endfunction()
