# Incremental deployment is a build optimization, never a signature check.
# Include the kit and runtime outputs so missing/updated DLLs invalidate the receipt.
function(hc_deploy_fingerprint Result)
    file(GLOB Inputs "${HC_QT_BIN}/*.dll" "${HC_QT_BIN}/*.exe")
    file(GLOB_RECURSE Plugins "${HC_QT_BIN}/../plugins/*" "${HC_QT_BIN}/../translations/*")
    file(GLOB_RECURSE Codecs "${HC_IMAGE_CODEC_PREFIX}/bin/*" "${HC_IMAGE_CODEC_PREFIX}/Licenses/*")
    list(APPEND Inputs ${Plugins} ${Codecs} "${HC_DEPLOY_EXE}" "${HC_PLUGIN_MANIFEST}"
        "${CMAKE_CURRENT_LIST_DIR}/DeployQt.cmake" "${CMAKE_CURRENT_LIST_DIR}/DeployQtCache.cmake"
        "${CMAKE_CURRENT_LIST_DIR}/../tools/Build-ImageCodecs.ps1"
        "${CMAKE_CURRENT_LIST_DIR}/ImageCodecDav1d.cmake")
    if(HC_RUNTIME_FILE)
        list(APPEND Inputs "${HC_RUNTIME_FILE}")
    endif()
    file(GLOB Outputs "${HC_OUTPUT}/*.dll" "${HC_OUTPUT}/QtWebEngineProcess.exe" "${HC_OUTPUT}/qt.conf")
    foreach(Directory IN ITEMS platforms imageformats iconengines styles generic networkinformation tls sqldrivers printsupport resources translations)
        file(GLOB_RECURSE Files "${HC_OUTPUT}/Libs/${Directory}/*")
        list(APPEND Outputs ${Files})
    endforeach()
    file(GLOB_RECURSE Licenses "${HC_OUTPUT}/Licenses/ImageCodecs/*")
    list(APPEND Inputs ${Outputs} ${Licenses})
    list(SORT Inputs)
    set(State "${HC_CONFIG};${HC_QT_BIN};${HC_WITH_TEST};${HC_WITH_PLUGINS};${HC_VS_DIR};${HC_RUNTIME_FILE}\n")
    foreach(Input IN LISTS Inputs)
        if(EXISTS "${Input}" AND NOT IS_DIRECTORY "${Input}")
            file(SIZE "${Input}" Size)
            file(TIMESTAMP "${Input}" Modified "%s.%f" UTC)
            string(APPEND State "${Input}|${Size}|${Modified}\n")
        else()
            string(APPEND State "${Input}|missing\n")
        endif()
    endforeach()
    string(SHA256 Fingerprint "${State}")
    set(${Result} "${Fingerprint}" PARENT_SCOPE)
endfunction()
