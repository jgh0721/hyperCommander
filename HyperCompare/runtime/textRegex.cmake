include_guard(GLOBAL)
include(FetchContent)
FetchContent_Declare(hc_pcre2
    URL https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.49/pcre2-10.49.tar.gz
    URL_HASH SHA256=929f0b20e62879252a15886b06c89f1edef61a363cbd5826fb041080a5e557ae
    SOURCE_SUBDIR hc-unused)
FetchContent_MakeAvailable(hc_pcre2)
function(hc_add_compare_regex)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    set(PCRE2_BUILD_PCRE2_8 ON)
    set(PCRE2_BUILD_PCRE2_16 OFF)
    set(PCRE2_BUILD_PCRE2_32 OFF)
    set(PCRE2_BUILD_PCRE2GREP OFF)
    set(PCRE2_BUILD_TESTS OFF)
    set(PCRE2_SUPPORT_JIT OFF)
    set(PCRE2_SUPPORT_UNICODE ON)
    set(PCRE2_SHOW_REPORT OFF)
    add_subdirectory("${hc_pcre2_SOURCE_DIR}" "${hc_pcre2_BINARY_DIR}" EXCLUDE_FROM_ALL)
    set_target_properties(pcre2-8-static PROPERTIES AUTOMOC OFF)
    if(MSVC)
        set_property(TARGET pcre2-8-static PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    endif()
endfunction()
hc_add_compare_regex()
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/$<CONFIG>/Licenses/pcre2.txt" INPUT "${hc_pcre2_SOURCE_DIR}/LICENCE.md")
