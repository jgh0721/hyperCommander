set(MANIFEST "")
if(USE STREQUAL "NONE")
    # Remove only build-owned package files when switching the same tree off.
    foreach(NAME IN ITEMS UnEGG64.dll UnEGG.txt UnEGG.zip alzegg.json source-lock.json)
        file(REMOVE "${OUTPUT}/${NAME}")
    endforeach()
    file(REMOVE "${LICENSES}/UnEGG.txt" "${LICENSES}/UnEGG.zip")
endif()
if(NOT USE STREQUAL "NONE")
    file(SHA256 "${SOURCE}/bin/UnEGG64.dll" BINARY_HASH)
    if(NOT BINARY_HASH STREQUAL "3ed936501325cfa7ca0841d92eec35e96027ae072eca59a49ced385bcd5c0eb6")
        message(FATAL_ERROR "UnEGG DLL identity mismatch")
    endif()
    file(MAKE_DIRECTORY "${OUTPUT}")
    file(COPY_FILE "${SOURCE}/bin/UnEGG64.dll" "${OUTPUT}/UnEGG64.dll" ONLY_IF_DIFFERENT)
    # The license text and original distribution archive live under Licenses/AlzEgg.
    file(MAKE_DIRECTORY "${LICENSES}")
    file(COPY_FILE "${SOURCE}/doc/UnEGG.txt" "${LICENSES}/UnEGG.txt" ONLY_IF_DIFFERENT)
    file(COPY_FILE "${ARCHIVE}" "${LICENSES}/UnEGG.zip" ONLY_IF_DIFFERENT)
    file(REMOVE "${OUTPUT}/UnEGG.txt" "${OUTPUT}/UnEGG.zip")
    set(MANIFEST "{\n  \"schemaVersion\":1, \"id\":\"hc.builtin.unegg\", \"version\":\"16.9.7.0\",\n  \"binary\":\"UnEGG64.dll\", \"sha256\":\"${BINARY_HASH}\",\n  \"format\":\"unegg\", \"architecture\":\"x64\", \"execution\":\"isolated\",\n  \"protocol\":{\"major\":1,\"minimumMinor\":0,\"maximumMinor\":0},\n  \"extensions\":[\"archive.read\"], \"permissions\":[\"content.read\"]\n}\n")
    file(CONFIGURE OUTPUT "${OUTPUT}/alzegg.json" CONTENT "${MANIFEST}" NEWLINE_STYLE CRLF)
    file(CONFIGURE OUTPUT "${OUTPUT}/source-lock.json" CONTENT "{\"url\":\"https://cf-aldn.altools.co.kr/setup/UnEGG.zip\",\"sha256\":\"90e8cc6d5df08eec11b4408b79f525a836e522ed94a8eac13f37e07f786c654f\",\"use\":\"${USE}\",\"license\":\"https://secure.altools.co.kr/support/License.aspx\"}\n" NEWLINE_STYLE CRLF)
endif()
string(ASCII 239 187 191 UTF8_BOM)
file(CONFIGURE OUTPUT "${HEADER}" CONTENT "${UTF8_BOM}#pragma once\ninline constexpr char HcBuiltinUnEggManifest[] = R\"hcegg(${MANIFEST})hcegg\";\n" NEWLINE_STYLE CRLF)
