file(MAKE_DIRECTORY "${OUTPUT}")
file(COPY_FILE "${CORE}" "${OUTPUT}/7z.dll" ONLY_IF_DIFFERENT)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ProductSigning.cmake")
hc_sign_packaged_file("${OUTPUT}/7z.dll")
file(SHA256 "${OUTPUT}/7z.dll" CORE_HASH)
set(MANIFEST "{\n  \"schemaVersion\": 1,\n  \"id\": \"hc.builtin.sevenzip\",\n  \"version\": \"26.03\",\n  \"binary\": \"7z.dll\",\n  \"sha256\": \"${CORE_HASH}\",\n  \"format\": \"7zip\",\n  \"architecture\": \"x64\",\n  \"execution\": \"isolated\",\n  \"protocol\": {\"major\": 1, \"minimumMinor\": 0, \"maximumMinor\": 0},\n  \"extensions\": [\"archive.read\", \"archive.write\"],\n  \"permissions\": [\"content.read\", \"content.write\"]\n}\n")
file(CONFIGURE OUTPUT "${OUTPUT}/sevenzip.json" CONTENT "${MANIFEST}" NEWLINE_STYLE CRLF)
string(ASCII 239 187 191 UTF8_BOM)
file(CONFIGURE OUTPUT "${HEADER}" CONTENT "${UTF8_BOM}#pragma once\ninline constexpr char HcBuiltinSevenZipManifest[] = R\"hc7z(${MANIFEST})hc7z\";\n" NEWLINE_STYLE CRLF)
# Notices and the source archive live under Licenses/SevenZip; the package keeps runtime files only.
file(MAKE_DIRECTORY "${LICENSES}")
foreach(NAME IN ITEMS License.txt copying.txt unRarLicense.txt)
    file(COPY_FILE "${SOURCE}/DOC/${NAME}" "${LICENSES}/${NAME}" ONLY_IF_DIFFERENT)
    file(REMOVE "${OUTPUT}/${NAME}")
endforeach()
file(COPY_FILE "${ARCHIVE}" "${LICENSES}/7z2603-src.tar.xz" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}/7z2603-src.tar.xz")
file(SHA256 "${ARCHIVE}" SOURCE_HASH)
file(CONFIGURE OUTPUT "${OUTPUT}/source-lock.json" CONTENT "{\"version\":\"26.03\",\"url\":\"https://www.7-zip.org/a/7z2603-src.tar.xz\",\"sha256\":\"${SOURCE_HASH}\",\"build\":\"Format7zF; portable C intrinsics; v145 x64 Hybrid CRT\"}\n" NEWLINE_STYLE CRLF)
