{
  "schema": 1,
  "product": "HyperCommander",
  "channel": "stable",
  "platform": "windows",
  "arch": "x64",
  "updaterProtocol": 1,
  "layoutVersion": 1,
  "versionPattern": "^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$",
  "maximumVersionSegment": 65535,
  "manifestAuthentication": "authenticode-catalog-sha256",
  "manifestMaxBytes": 262144,
  "catalogMaxBytes": 1048576,
  "catalogMaxMembers": 16,
  "archiveMaxBytes": 1073741824,
  "unpackedMaxBytes": 2147483648,
  "fileMaxBytes": 536870912,
  "entryMaxCount": 4096,
  "manifestRedirectLimit": 5,
  "transferIdleTimeoutSeconds": 30,
  "transferTotalTimeoutSeconds": 1800,
  "archiveReader": "builtin-sevenzip-forward-stream",
  "archiveLinkPolicy": "reject",
  "fileSystems": ["NTFS", "ReFS"],
  "networkInstall": false,
  "elevatedInstall": false
}
